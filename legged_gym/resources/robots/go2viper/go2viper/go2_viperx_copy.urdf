<?xml version="1.0"?>
<robot name="go2viper">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <!-- ===== Go2 subtree (from go2.urdf) ===== -->

  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- Fixed mount between Go2 upper body and ViperX base -->
  <joint name="go2_to_vx_mount" type="fixed">
    <parent link="base"/>
    <child  link="vx_base_link"/>
    <!-- Adjust as needed -->
    <origin xyz="0 0 0.053" rpy="0 0 0"/>
  </joint>

  <joint name="floating_base" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="trunk"/>
  </joint>

